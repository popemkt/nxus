# nxus environment reference — copy to .env and fill what you need.
# Launch-mode env SETS live in envs/*.env (pnpm dev:graph / e2e:graph load
# them automatically — don't export mode vars by hand).
# Everything has a working default for local dev; nothing here is required
# to run `pnpm dev`. Canonical prose: spec/tech/toolchain.md, persistence.md.

# --- Core -------------------------------------------------------------------
# Storage mode: node (SQLite, default) | graph (SurrealDB, experimental target)
ARCHITECTURE_TYPE=node
# SQLite DB path override (default: libs/nxus-db/src/data/nxus.db — moving to
# ~/.nxus/ per production plan P2). e2e uses $TMPDIR/nxus-e2e.db.
#NXUS_DB_PATH=

# --- SurrealDB (graph mode only) ---------------------------------------------
# Embedded surrealkv is single-process ONLY; any multi-process topology (dev
# servers, e2e) needs a real server: learnings/surrealkv-multiprocess.md
#SURREAL_EMBEDDED=false
#SURREAL_URL=http://127.0.0.1:8790/rpc
#SURREAL_USER=root
#SURREAL_PASS=root
#SURREAL_NS=nxus
#SURREAL_DB=nxus
#SURREAL_PATH=
#SURREAL_MEMORY=

# --- AI (recall question generation, Mastra agents) --------------------------
#ANTHROPIC_API_KEY=

# --- Google Calendar 2-way sync (calendar app) --------------------------------
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_REDIRECT_URL=

# --- Apps/gallery install roots (core app) ------------------------------------
#APP_REPO_ROOT=
#APP_DEFAULT_INSTALL_ROOT=
#APP_DATA_ROOT=

# --- Test/perf gates (off by default) -----------------------------------------
# NXUS_E2E=1        # set by playwright webServer; disables Vite error overlay
# NXUS_PERF=1       # enable perf-budget tests (libs/nxus-db benchmarks)
# NXUS_PERF_50K=1   # 50k-node budget tier
# NXUS_BENCH_N=     # benchmark scale override
# PW_REUSE_SERVER=1 # reuse running dev servers for fast local e2e iteration
