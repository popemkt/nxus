# Graph-mode launch configuration (SurrealDB backend).
# Consumed by scripts/with-graph-env.mjs (pnpm dev:graph / e2e:graph),
# which also starts the local SurrealDB server if it isn't running.
# Node mode is the zero-config default — it has no env file on purpose.
ARCHITECTURE_TYPE=graph
SURREAL_EMBEDDED=false
SURREAL_URL=http://127.0.0.1:8790/rpc
SURREAL_USER=root
SURREAL_PASS=root
